<h1 align="center"> Inicio do pedido </h1>
<br>
<div class="row">
  <div class="col">
    <strong><%= Order.human_attribute_name(:code) %>: </strong>
    <%= @order.code %><br>
    <strong>Pedido criado por: </strong>
    <%= @user.name %><br>
  </div>
  <div class="col">
    <h5>Coleta:</H5>
    <h6><strong><%= Order.human_attribute_name(:collect_zip) %>: </strong>
    <%= @order.collect_zip %><br>
    <strong><%= Order.human_attribute_name(:collect_street) %>: </strong><br>
    <%= @order.collect_street %>, <%= @order.collect_number %> - <%= @order.collect_nhood %><br>
    <%= @order.collect_city %> - <%= @order.collect_state %></h6>
  </div>
  <div class="col">
    <h5>Destino:</h5>
    <h6><strong><%= Order.human_attribute_name(:deliv_reipient) %>: </strong>
    <%= @order.deliv_reipient %><br>
    <strong><%= Order.human_attribute_name(:deliv_zip) %>: </strong>
    <%= @order.deliv_zip %><br>
    <strong><%= Order.human_attribute_name(:deliv_street) %>: </strong><br>
    <%= @order.deliv_street %>, <%= @order.deliv_number %> - <%= @order.deliv_nhood %><br>
    <%= @order.deliv_city %> -  <%= @order.deliv_state %></h6>
  </div>
</div>
<br>
<div class="row">
  <div class="col">
    <strong>Dimensões do produto: </strong>
    <%= @order.width %>cm X <%= @order.height %>cm X <%= @order.depth %>cm<br>
    <strong><%= Order.human_attribute_name(:weight) %>: </strong>
    <%= @order.weight %>kg<br>
    <strong><%= Order.human_attribute_name(:km_dist) %>: </strong>
    <%= @order.km_dist %>km<br>
    <strong><%= Order.human_attribute_name(:status) %>: </strong>
    <%= I18n.t(@order.status) %>
  </div>
</div>
<br>
<h5 align="center"> Opções de entrega - Valores e prazos</h5><br>
<div class="row" align="center">
  <% @shippings.each do |shipping| %>
    <div class="col">
      <div class="card" style="width: 18rem;">
        <%= image_tag('transporte.jpeg', class: "card-img-top", alt: "Modelidade: #{shipping.name}") %>
        <div class="card-body">
          <h5 class="card-title" align="center"><%=shipping.name %></h5>
          <p class="card-text">
            <strong>Valor total da operação:    </strong><br>
            <%  if @cost.find_by(shipping: shipping).present? %>
              <% total_cost = @cost.find_by(shipping: shipping).km_value * @order.km_dist + shipping.deliv_fee %>
              <%= number_to_currency(total_cost) %><br>
              (Valor do km rodado: <%= number_to_currency(@cost.find_by(shipping: shipping).km_value) %>)<br>
            <% else %>
              <p> Custo do KM rodado não cadastrado</p>
            <% end %>
            <strong>Valor de taxa de entrega:   </strong><br><%= number_to_currency(shipping.deliv_fee) %><br>
            <%  if @deliv_term.find_by(shipping: shipping).present? %>
              <strong>Tempo total da operação:    </strong><br><%= @deliv_term.find_by(shipping: shipping).deliv_term %>dias<br>
            <% else %>
              <p> Prazo de entrega não cadastrado</p>
            <% end %>
            <% if @vehicle.nil? %>
              <strong>Transporte não disponível.</strong>
            <% else %>
              <strong>Transporte disponível:    </strong><br><%= @vehicle.license_plate %><br>
              <%= @vehicle_type.manufacturer_vehicle %> - <%= @vehicle_type.model_vehicle %><br><br><br>
            <% end %>
            </p>
            <% if @cost.find_by(shipping: shipping).present? && @vehicle.present? && @deliv_term.find_by(shipping: shipping).present? %>
              <%= link_to "iniciar entrega", select_modal_order_path(:shipping_id => shipping.id, :vehicle_id => @vehicle.id, 
                                                                    :order_id => @order.id, :total_cost => total_cost), 
                  class: "btn btn-primary", id: "#{shipping.name}" %>
            <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>