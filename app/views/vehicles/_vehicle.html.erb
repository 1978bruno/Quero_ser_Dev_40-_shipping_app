<table class="table table-light table-hover">
<thead>
  <tr align='center'>
    <th scope="col"><strong><%= Vehicle.human_attribute_name(:license_plate) %></strong></th>
    <th scope="col"> <strong><%= Vehicle.human_attribute_name(:manufacturer_vehicle) %></th>
    <th scope="col"><strong><%= Vehicle.human_attribute_name(:model_vehicle) %></th>
    <th scope="col"><strong><%= Vehicle.human_attribute_name(:manufature_year) %></th>
    <th scope="col"><strong><%= Vehicle.human_attribute_name(:maximum_load_capacity) %></th>
    <th scope="col"><strong><%= Vehicle.human_attribute_name(:status) %></th>
    <th scope="col">#</th>
  </tr>
</thead>
<tbody>
  <% @vehicles.each do |vehicle| %>
    <tr align='center'>
      <td><%= link_to vehicle.license_plate, edit_vehicle_path(vehicle.id) %></td>
      <td><%= @vehicle_types.find(vehicle.vehicle_type_id).manufacturer_vehicle %></td>
      <td><%= @vehicle_types.find(vehicle.vehicle_type_id).model_vehicle %></td>
      <td><%= @vehicle_categories.find(vehicle.vehicle_category_id).category %></td>
      <td><%= vehicle.manufature_year %></td>
      <td><%= I18n.t(vehicle.status) %></td>
    </tr>
  <% end %>
</tbody>
</table>



<div class="card" style="width: 20rem;">
  <div class="card-body">
    <h5 class="card-title" align="center"><strong><%= Vehicle.human_attribute_name(:license_plate) %></strong></h5>
    <h6 class="card-subtitle mb-2 text-muted" align="center"><%= link_to vehicle.license_plate, edit_vehicle_path(vehicle.id) %></h6>
    <p class="card-text">
      <strong><%= Vehicle.human_attribute_name(:manufacturer_vehicle) %>: </strong>
      <%= @vehicle_types.find(vehicle.vehicle_type_id).manufacturer_vehicle %><br>
      <strong><%= Vehicle.human_attribute_name(:model_vehicle) %>: </strong>
      <%= @vehicle_types.find(vehicle.vehicle_type_id).model_vehicle %><br>
      <strong><%= Vehicle.human_attribute_name(:vehicle_category_id) %>: </strong>
      <%= @vehicle_categories.find(vehicle.vehicle_category_id).category %><br>
      <strong><%= Vehicle.human_attribute_name(:manufature_year) %>: </strong>
      <%= vehicle.manufature_year %><br>
      <strong><%= Vehicle.human_attribute_name(:maximum_load_capacity) %>: </strong>
      <%= vehicle.maximum_load_capacity %>kg<br>
      <strong><%= Vehicle.human_attribute_name(:status) %>: </strong>
      <%= I18n.t(vehicle.status) %><br>
      <div class="row">
        <div class="col" align="center">
           <%= link_to 'Editar', edit_vehicle_path(vehicle.id), class: "btn btn-light"  %>
        </div>
        <div class="col" align="center">
          <% if vehicle.status == 'disabled' %>
            <%= button_to 'Ativar', active_vehicle_path(vehicle.id), class: "btn btn-light"  %>
          <% else %>
            <%= button_to 'Desativar', disable_vehicle_path(vehicle.id), class: "btn btn-light"  %>
          <% end %>
        </div>
       </div> 
    </p>
  </div>
</div>