<%= form_with(model: @vehicle) do |f| %>
  <div class="row">
    <div class="col-1"><strong><%=f.label :license_plate, class: "form-label"  %></strong></div>
    <div class="col-2"><%= f.text_field :license_plate, class: 'form-control' %></div>
  </div>
  <div class="row">
    <div class="col-1"><strong><%=f.label :vehicle_types_id, "Modelo", class: "form-label"  %></strong></div>
    <div class="col-2"><%= f.collection_select :vehicle_types_id, @vehicle_types, :id, :model_vehicle, {:include_blank => true}, {class: "form-control"} %></div>
  </div>
  <div class="row">
    <div class="col-1"><strong><%=f.label :vehicle_categories_id, class: "form-label"  %></strong></div>
    <div class="col-2"><%= f.collection_select :vehicle_categories_id, @vehicle_categories, :id, :category, {:include_blank => true}, {class: "form-control"} %></div>
  </div>
  <div class="row">
    <div class="col-1"><strong><%=f.label :manufature_year, class: "form-label"  %></strong></div>
    <div class="col-2"><%= f.number_field :manufature_year, class: 'form-control' %></div>
  </div>
  <div class="row">
    <div class="col-1"><strong><%=f.label :maximum_load_capacity, class: "form-label"  %></strong></div>
    <div class="col-2"><%= f.number_field :maximum_load_capacity, class: 'form-control' %></div>
  </div>
  <div class="form-check">
    <div class="row">
      <div class="col-1"><strong><%= f.label :status, class: 'form-check-label' %></strong></div>
      <div class="col-2"><%= f.check_box :status, class: 'form-check-input' %>Ativo</div>
    </div>
  </div>
  <div class="row">
    <div class="col-2" align="center"><%= f.submit 'Gravar', class: "btn btn-light" %></div>
  </div>
<% end %>