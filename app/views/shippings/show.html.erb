<h2 align="center">Detalhes da modalidade</h2>
<br>
<br>
<div class="row">
  <div class="col-3">
    <strong>Nome da Modalidade:   </strong><%= @shipping.name %><br><br>
    <strong>Distância mínima:     </strong><%= @shipping.min_dist %>km<br>
    <strong>Distância máxima:     </strong><%= @shipping.max_dist %>km<br>
    <strong>Peso mínimo da carga: </strong><%= @shipping.min_weight %>kg<br>
    <strong>Peso máximo da carga: </strong><%= @shipping.max_weight %>kg<br>
    <strong>Tarifa padrão:     R$ </strong><%= @shipping.deliv_fee %><br>
    <strong>Situação:             </strong><%= I18n.t(@shipping.status) %><br>
  </div>
  
    <% if @cost.nil? || @deliv_term.nil? %>
      <div class="col">
        <p>Não existe modalidades de transportes cadastrados</p>
      </div>
    <% else %>
      <div class="col">
        <h5 align='center'> Custos </h5>
        <table class="table table-light table-hover">
          <thead>
            <tr align='center'>
              <th scope="col">Menor peso do intervalo</th>
              <th scope="col">Maior peso do intervalo</th>
              <th scope="col">Valor do KM</th>
              <th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            <% @cost.each do |cost| %>
              <tr align='center'>
                <td><%= cost.int_min_weight %>kg</td>
                <td><%= cost.int_max_weight %>kg</td>
                <td><%= number_to_currency(cost.km_value) %></td>
                <td id="cost_<%= cost.id %>">
                  <%= link_to edit_cost_path(cost.id) do%>
                    <%= image_tag('edit.png',size: '12x25', alt: "editar" ) %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <br>
        <h5 align='center'> Prazos </h5>

        <table class="table table-light table-hover">
          <thead>
            <tr align='center'>
              <th scope="col">Menor peso do intervalo</th>
              <th scope="col">Maior peso do intervalo</th>
              <th scope="col">Prazo de entrega</th>
              <th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            <% @deliv_term.each do |deliv_term| %>
              <tr align='center'>
                <td><%= deliv_term.term_int_min_weight %>kg</td>
                <td><%= deliv_term.term_int_max_weight %>kg</td>
                <td><%= deliv_term.deliv_term %> dias</td>
                <td id="deliv_term_<%= deliv_term.id %>">
                  <%= link_to edit_deliv_term_path(deliv_term.id) do%>
                    <%= image_tag('edit.png',size: '12x25', alt: "editar" ) %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>

      </div>
    <% end %>
  <%= link_to('Voltar', root_path) %>
</div>