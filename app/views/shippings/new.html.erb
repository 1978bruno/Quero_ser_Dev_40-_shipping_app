<h1>Formulário de cadastro de novas modalidades de transporte</h1>

<%= form_with(model: Shipping.new) do |f| %>
  <div>
    <%=f.label :name, 'Nome' %>
    <%= f.text_field :name %>
  </div>
  <div>
    <%=f.label :min_dist, 'Distância mínima' %>
    <%= f.number_field :min_dist %>
  </div>
  <div>
    <%=f.label :max_dist, 'Distância máxima' %>
    <%= f.number_field :max_dist %>
  </div>
  <div>
    <%=f.label :min_weight, 'Peso mínimo' %>
    <%= f.number_field :min_weight %>
  </div>
  <div>
    <%=f.label :max_weight, 'Peso máximo' %>
    <%= f.number_field :max_weight %>
  </div>
  <div>
    <%=f.label :deliv_fee, 'Tarifa de entrega' %>
    <%= f.number_field :deliv_fee %>
  </div>
  <div>
    <%= f.label :status, 'Status' %>
    <%= f.check_box :status %>

  </div>

  <div>
    <%= f.submit 'Enviar'  %>
  </div>
<% end %>