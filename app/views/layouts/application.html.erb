<!DOCTYPE html>
<html>
  <head>
    <title>ShippingApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
  </head>

  <body>
        <header>
      <%= link_to root_path do%>
        <h1> Transportadora</h1>
      <% end %>
      <nav>
        <%= link_to 'Veículos', vehicles_path %> | 
        <%= link_to 'Cadastrar Veículo', new_vehicle_path %> | 
        <%= link_to 'Cadastrar Custo', new_cost_path %> | 
        <%= link_to 'Cadastrar Prazo', new_deliv_term_path %> | 
        <%= link_to 'Criar ordem', new_order_path %> |
        <% if user_signed_in? %>
          <%= button_to 'Sair', destroy_user_session_path, method: :delete %>
          <%= current_user.name %> | <%= current_user.email %>
        <% else %>
          <%= link_to 'Entrar', new_user_session_path %> |
        <% end %>
      </nav>
    </header>
    <main>
      <div>
        <%= alert %>
        <%= notice %>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
