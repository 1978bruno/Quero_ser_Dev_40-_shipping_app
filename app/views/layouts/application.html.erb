<!DOCTYPE html>
<html>
  <head>
    <title>ShippingApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
  </head>

  <body>
        <header>
      <%= link_to root_path do%>
        <h1> Transportadora</h1>
      <% end %>
      <nav>
        <%= link_to 'Veículos', vehicles_path %> | 
        <%= link_to 'Cadastrar Veículo', new_vehicle_path %> | 
      </nav>
    </header>
    <main>
      <div>
        <%= alert %>
        <%= notice %>
      </div>
      <%= yield %>
    </main>
  </body>
</html>
