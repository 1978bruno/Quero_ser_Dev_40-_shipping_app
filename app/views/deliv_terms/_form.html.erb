<%= form_with(model: @deliv_term ) do |f| %>
  <div class="row">
    <div class="col-1"><strong><%=f.label :shipping_id, 'Modelo', class: "form-label" %></strong></div>
    <div class="col-2"><%= f.collection_select :shipping_id, @shipping, :id, :name, {:include_blank => true}, {class: "form-control"} %></div>
  </div>
  <div class="row">
    <div class="col-1"><strong><%=f.label :term_int_min_weight, class: "form-label" %></strong></div>
    <div class="col-2"><%= f.number_field :term_int_min_weight, class: 'form-control' %></div>
  </div>
  <div class="row">
    <div class="col-1"><strong><%=f.label :term_int_max_weight, class: "form-label" %></strong></div>
    <div class="col-2"><%= f.number_field :term_int_max_weight, class: 'form-control' %></div>
  </div>
  <div class="row">
    <div class="col-1"><strong><%=f.label :deliv_term, class: "form-label" %></strong></div>
    <div class="col-2"><%= f.number_field :deliv_term, class: 'form-control' %></div>
  </div>

  <div class="row">
    <div class="col-2" align="center"><%= f.submit 'Cadastrar', class: "btn btn-light" %></div>
  </div>
<% end %>