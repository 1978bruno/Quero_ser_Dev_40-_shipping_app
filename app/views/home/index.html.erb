<h2>Lista de modalidades</h2>
<div>
  <%= link_to('Cadastrar modalidade', new_shipping_path) %>
</div>
<div>
  <%= form_with url: search_shippings_path, method: :get do |form| %>
    <%= form.label :query, "Buscar Modalidade" %>
    <%= form.text_field :query %>
    <%= form.submit "Buscar" %>
  <% end %><br><br>
</div>
<div class="row">
  <% @shippings.each do |s| %>
    <div class="col-2">
      <div class="card" style="width: 18rem;">
        <div class="card-body">
          <h5 class="card-title" align="center"><strong><%= Shipping.human_attribute_name(:name)  %> </strong></h5>
          <h6 class="card-subtitle mb-2 text-muted" align="center"><%= link_to s.name,  shipping_path(s.id) %></h6>
          <p class="card-text">
          <strong><%= Shipping.human_attribute_name(:min_dist) %>:   </strong><%= s.min_dist %>km<br>
          <strong><%= Shipping.human_attribute_name(:max_dist) %>:   </strong><%= s.max_dist %>km<br>
          <strong><%= Shipping.human_attribute_name(:status) %>:     </strong><%= I18n.t(s.status) %><br>
        </div>
      </div>
    </div>
  <% end %>
</div>
<div>
  <% if @shippings.empty? %>
    <p>Não existe detalhes de custo e prazo cadastrados</p>
  <% end %>
</div>