<h1>Fretes</h1>
<br>
  <div class="row">
    <div class="col-2">
        <strong><%= Order.human_attribute_name(:code) %>: </strong>
        <%= @order.code %><br>
        <strong>Pedido criado por: </strong>
        <%= @user.name %><br>
      </div>
  </div>
<br>
  <div class="row">
    <div class="col-2">
      <h5>Coleta:</H5><br>
      <strong><%= Order.human_attribute_name(:collect_zip) %>: </strong>
      <%= @order.collect_zip %><br>
      <strong><%= Order.human_attribute_name(:collect_street) %>: </strong><br>
      <%= @order.collect_street %>, <%= @order.collect_number %> - <%= @order.collect_nhood %><br>
      <%= @order.collect_city %> - <%= @order.collect_state %>
    </div>
    <div class="col-2">
      <h5>Destino:</h5><br>
      <strong><%= Order.human_attribute_name(:deliv_reipient) %>: </strong>
      <%= @order.deliv_reipient %><br>
      <strong><%= Order.human_attribute_name(:deliv_zip) %>: </strong>
      <%= @order.deliv_zip %><br>
      <strong><%= Order.human_attribute_name(:deliv_street) %>: </strong><br>
      <%= @order.deliv_street %>, <%= @order.deliv_number %> - <%= @order.deliv_nhood %><br>
      <%= @order.deliv_city %> -  <%= @order.deliv_state %>
    </div>
  </div>
<br>
  <div class="row">
    <div class="col=4">
      <strong>Dimensões do produto: </strong>
      <%= @order.width %>cm X <%= @order.height %>cm X <%= @order.depth %>cm<br>
      <strong><%= Order.human_attribute_name(:weight) %>: </strong>
      <%= @order.weight %>kg<br>
      <strong><%= Order.human_attribute_name(:km_dist) %>: </strong>
      <%= @order.km_dist %>km<br>
      <strong><%= Order.human_attribute_name(:status) %>: </strong>
      <%= I18n.t(@order.status) %>
    </div>
  </div>
<br>
  <div>
    <h5> Valor e prazo de entrega</h5><br>
    <%= @shippings.each do |shipping| %>
      <div class="row">
        <div class="col-4"><strong>Modalidade de transporte:   </strong><%= @shipping_name %><br></div>
      <div class="row">
        <div class="col-2">
          <strong>Tempo total da operação:    </strong><%= @value_deliv %><br>
          <strong>Valor total da operação:    </strong>R$ <%= @value_km %>,00 (Valor do km rodado: R$ 0,<%= @cost_km %>)<br>
        </div>
        <div class="col-2">
          <strong>Valor de taxa de entrega:   </strong>R$ <%= @cost_fee %>,00<br>
          <strong>Tempo total da operação:    </strong><%= @term_deliv %><br><br>
        </div>
      </div>
      <div class="row">
        <div class="col-1"><Strong> Selecionar Modalidade:     </strong></div>
        <div class="col-2"><%= button_to @shipping_name, select_modal_order_path(shipping.id), class: 'btn btn-light' %></div>
      </div>
    <% end %>
  </div>