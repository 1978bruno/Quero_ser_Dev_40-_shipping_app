<h1 align="center">Lista de pedidos em aberto</h1>
<br>

<% if @order.empty? %>
  <p>Nenhuma ordem cadastrada neste usuário</p>
<% else %>
  <div class="row">
    <% @order.each do |order| %>
      <div class="col">
        <%= render order %>
      </div>
    <% end %>
</div>
<% end %>
