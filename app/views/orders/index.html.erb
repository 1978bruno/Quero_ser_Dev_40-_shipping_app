<h1 align="center">Lista de pedidos em aberto</h1>


<% if @order.empty? %>
  <p> Nenhum veículo cadastrado</p>
<% else %>
  <div class="row">
    <% @order.each do |order| %>
      <div class="col-3">
        <%= render order %>
      </div>
    <% end %>
</div>
<% end %>
  
<div>
  <%= link_to('Voltar', root_path) %>
</div>
